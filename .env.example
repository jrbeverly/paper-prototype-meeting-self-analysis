# AWS and non-secret configuration
AWS_REGION=ca-central-1
MI_CONFIG_FILE=config/local.json
# Alternative JSON sources; use only one of MI_CONFIG_FILE, MI_CONFIG_JSON,
# or MI_CONFIG_PARAMETER. The --config Python flag overrides all three.
# MI_CONFIG_JSON={}
# MI_CONFIG_PARAMETER=/meeting-intelligence/dev/config

# This overrides artifactBucket for Python and configures the Go downloader.
MI_BUCKET=meeting-intelligence-dev-artifacts
MI_RECORDINGS_PREFIX=meetings
MI_QUARANTINE_PREFIX=quarantine
EXPECTED_BUCKET_OWNER=123456789012

# General OAuth broker (the broker owns Zoom refresh-token rotation)
GENERAL_OAUTH_TOKEN_URL=https://oauth-broker.example.internal/v1/token/zoom
GENERAL_OAUTH_TOKEN_METHOD=POST
# Include the complete scheme/value. Do not commit the real value.
GENERAL_OAUTH_AUTHORIZATION='Bearer replace-me'
# Optional additional string headers. Applied after default headers.
GENERAL_OAUTH_HEADERS_JSON={}
# CodeBuild can inject this complete broker secret instead. Individual
# GENERAL_OAUTH_* variables above take precedence when both are present.
# MI_ZOOM_OAUTH_SECRET_JSON='{"tokenUrl":"https://...","method":"POST","authorization":"Bearer ...","headers":{}}'

# Zoom discovery
ZOOM_USERS=me
ZOOM_LOOKBACK_DAYS=1
# Explicit YYYY-MM-DD values override the rolling window.
# ZOOM_FROM=2026-07-23
# ZOOM_TO=2026-07-24
ZOOM_API_BASE=https://api.zoom.us/v2
# AWS_CLI=aws
# UPLOAD_PART_SIZE_MIB=16
# UPLOAD_CONCURRENCY=3

# Secret JSON values. In CodeBuild these are populated from Secrets Manager.
# Jira: {"site":"https://example.atlassian.net","email":"...","apiToken":"..."}
MI_JIRA_SECRET_JSON='{"site":"https://example.atlassian.net","email":"replace-me","apiToken":"replace-me"}'
# Confluence supports basic auth (email/apiToken) or bearer auth (token only).
MI_CONFLUENCE_SECRET_JSON='{"email":"replace-me","apiToken":"replace-me"}'
# Microsoft Graph client credentials for outbound clip uploads.
MI_GRAPH_SECRET_JSON='{"tenantId":"replace-me","clientId":"replace-me","clientSecret":"replace-me"}'
